# ---------------------------------------------------------------------------
# Contact form API environment configuration (Cloudflare Worker)
#
# The worker lives in /worker. This file documents every variable the worker
# reads. Never commit real values — supply them through the deployment
# environment instead, e.g. with the Wrangler CLI from /worker:
#
#   npx wrangler secret put CONTACT_EMAIL
#   npx wrangler secret put MAIL_FROM
#   npx wrangler secret put WHATSAPP_RECIPIENT_NUMBER
#   npx wrangler secret put WHATSAPP_PHONE_NUMBER_ID
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put WHATSAPP_ACCESS_TOKEN
#
# Non-secret defaults (API URLs, template name, allowed origin) already live
# in worker/wrangler.toml under [vars].
# ---------------------------------------------------------------------------

# Email notification recipient (the site owner).
CONTACT_EMAIL=

# Verified sender address for the email provider (Resend).
# While testing you can use: onboarding@resend.dev
MAIL_FROM=

# Resend API key (https://resend.com -> API Keys). Secret.
RESEND_API_KEY=

# Resend API base URL (default: https://api.resend.com). Override for tests.
RESEND_API_URL=

# WhatsApp Business Cloud API phone number ID
# (Meta Business Manager -> WhatsApp -> API Setup). Account-specific.
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Cloud API access token (System User permanent token). Secret.
WHATSAPP_ACCESS_TOKEN=

# Recipient WhatsApp number in E.164 format without '+' (e.g. 919967832161).
WHATSAPP_RECIPIENT_NUMBER=

# Graph API version (default: v23.0).
WHATSAPP_API_VERSION=

# Pre-approved outbound template. Must exist in the WABA with exactly:
#   New Portfolio Contact
#   Name: {{1}}
#   Email: {{2}}
#   Message: {{3}}
#   Source: Portfolio Website
WHATSAPP_TEMPLATE_NAME=

# Template language code (default: en_US).
WHATSAPP_TEMPLATE_LANGUAGE=

# Graph API base URL (default: https://graph.facebook.com). Override for tests.
WHATSAPP_GRAPH_URL=

# Allowed frontend origin for CORS (default: https://khan-sohail.github.io).
CONTACT_ALLOWED_ORIGIN=